# Claude Catche 部署配置
# 复制此文件为 .env 并填写你的值
# 不填的项保持默认值

# 管理面板登录密码（默认 admin123，部署时务必修改）
ADMIN_PASSWORD=在这里填你的管理密码

# 账户访问密钥，客户端通过 x-api-key 或 Authorization: Bearer 发送
ACCESS_KEY=在这里填你的访问密钥

# 订阅账号凭据加密密钥。必须是标准 base64 编码的 32 字节随机值。
# 可用命令生成：openssl rand -base64 32
CATCH_MASTER_KEY=

# Docker 镜像版本：latest / main / 已发布的提交短 SHA
CATCH_IMAGE_TAG=latest

# 监听端口（默认 53247）
# PORT=53247
